<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      External demo project. Inherits summer-starter-parent (same convention as a
      Spring Boot app inheriting spring-boot-starter-parent): the parent supplies the
      AOT / Jandex / compiler build wiring so this pom stays thin, while the demo still
      builds independently and consumes Summer purely as published artifacts. The
      parent is NOT part of the framework reactor.
    -->
    <parent>
        <groupId>com.github.dropguard.summer.samples</groupId>
        <artifactId>summer-samples</artifactId>
        <version>0.3.2-SNAPSHOT</version>
    </parent>

    <groupId>com.github.dropguard.summer.realworld</groupId>
    <artifactId>summer-realworld</artifactId>
    <version>0.3.2-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Summer RealWorld</name>
    <description>RealWorld example application demonstrating the Summer framework</description>

    <dependencies>
        <!-- Summer starters: core pulled in transitively; web + JDBC persistence. -->
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-boot-starter-web</artifactId>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-boot-starter-data-jdbc</artifactId>
            <type>pom</type>
        </dependency>

        <!-- runtime: supplies the @ConfigMapping interface binder used by tests that bind
             config interfaces via ConfigBinder (interface binding lives only in runtime). -->
        <!-- summer-runtime must NOT be declared test-scoped here: the direct test dep would
             override the compile-scoped transitive dep (starter → boot → runtime), stripping
             the DI engine from the production classpath and breaking the shaded jar. -->
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-runtime</artifactId>
        </dependency>

        <!-- PostgreSQL database (realworld persists to Postgres) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
        </dependency>

        <!-- BCrypt -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Testing: summer-test transitively supplies JUnit, Mockito, and the runtime
             interface binder, so they are not declared here. -->
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Real-database integration tests: Postgres via Testcontainers, managed by the
             framework-owned PostgresTestResource (@TestResource). Versions ride the BOM
             (summer-build-parent imports summer-dependencies); only postgresql is pinned
             as a driver by the twitter convention. -->
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-test-db</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>summer-realworld</finalName>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.github.dropguard.summer.realworld.Application</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.github.dropguard.summer.realworld.Application</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
