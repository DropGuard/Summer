<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor name="summer-archetype">
    <requiredProperties>
        <requiredProperty key="frameworkVersion">
            <defaultValue>0.1.1-SNAPSHOT</defaultValue>
        </requiredProperty>
    </requiredProperties>
    <fileSets>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>src/main/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>
        <fileSet filtered="true" encoding="UTF-8">
            <directory>src/main/resources</directory>
            <includes>
                <include>**/*.yml</include>
            </includes>
        </fileSet>
    </fileSets>
</archetype-descriptor>
