#!/bin/sh
# Summer Framework Pre-Commit Hook

echo "[Summer Pre-Commit] 🔍 Running Spotless code formatting..."

# Run Spotless (only formats, does not stage)
if ! mvn spotless:apply; then
    echo "[Summer Pre-Commit] ❌ Spotless formatting failed. Commit aborted."
    exit 1
fi

# Find all Java files that are currently staged and re-add them in case Spotless modified them
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.java$')
if [ -n "$STAGED_FILES" ]; then
    for FILE in $STAGED_FILES; do
        if [ -f "$FILE" ]; then
            git add "$FILE"
        fi
    done
fi

echo "[Summer Pre-Commit] ✅ Formatting complete! Proceeding with commit."
