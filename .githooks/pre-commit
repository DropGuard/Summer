#!/bin/sh
# Summer Framework Pre-Commit Hook
# Gate 1: rejects the commit if any Java file is not Spotless-clean.
#         Developer runs `mvn spotless:apply` manually, then re-stages.
# Gate 2: when production sources are staged, runs the ArchUnit rules (summer-archunit)
#         against the current sources (-am rebuilds the upstream modules; only the arch
#         tests run).

echo "[Summer Pre-Commit] Checking code formatting..."

if ! mvn spotless:check -q; then
    echo ""
    echo "[Summer Pre-Commit] Formatting violations detected."
    echo "  Run:  mvn spotless:apply"
    echo "  Then: git add the reformatted files and commit again."
    exit 1
fi

echo "[Summer Pre-Commit] Formatting OK."

# Docs-only and test-only commits skip the architecture gate.
if git diff --cached --name-only --diff-filter=ACMR | grep -q '/src/main/.*\.java$'; then
    echo "[Summer Pre-Commit] Checking architecture rules..."
    if ! mvn -B -q -pl summer-archunit -am test \
            -Dtest='com.github.dropguard.summer.arch.**' \
            -Dsurefire.failIfNoSpecifiedTests=false -Djacoco.skip=true; then
        echo ""
        echo "[Summer Pre-Commit] Architecture violations detected (see output above)."
        exit 1
    fi
    echo "[Summer Pre-Commit] Architecture OK."
fi
