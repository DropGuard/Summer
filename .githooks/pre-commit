#!/bin/sh
# Summer Framework Pre-Commit Hook
# Gate: rejects commit if any staged Java file is not Spotless-clean.
# Developer runs `mvn spotless:apply` manually, then re-stages.

echo "[Summer Pre-Commit] Checking code formatting..."

if ! mvn spotless:check -q; then
    echo ""
    echo "[Summer Pre-Commit] Formatting violations detected."
    echo "  Run:  mvn spotless:apply"
    echo "  Then: git add the reformatted files and commit again."
    exit 1
fi

echo "[Summer Pre-Commit] Formatting OK."
