<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.dropguard</groupId>
        <artifactId>summer-parent</artifactId>
        <version>0.2.0</version>
        <relativePath>summer-parent/pom.xml</relativePath>
    </parent>

    <artifactId>summer-framework</artifactId>
    <packaging>pom</packaging>

    <name>Summer Framework</name>
    <description>A minimal, chain-oriented micro framework for building CRUD APIs on modern JDK</description>
    <url>https://github.com/DropGuard/Summer</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>DropGuard</name>
            <url>https://github.com/DropGuard</url>
        </developer>
    </developers>

    <properties>
        <jacoco.version>0.8.15</jacoco.version>
    </properties>

    <scm>
        <!-- Required by maven-release-plugin (the milestone version sweep). -->
        <connection>scm:git:https://github.com/DropGuard/Summer.git</connection>
        <developerConnection>scm:git:git@github.com:DropGuard/Summer.git</developerConnection>
        <url>https://github.com/DropGuard/Summer</url>
    </scm>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.dropguard</groupId>
                <artifactId>summer-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <!-- Parents as modules: the archetype IT's generated project resolves summer-build-parent
             from the local repository, so `mvn clean install` must install it (and its parent
             summer-parent, which nothing else installs). -->
        <module>summer-parent</module>
        <module>summer-dependencies</module>
        <module>summer-build-parent</module>
        <module>summer-core</module>
        <module>summer-web</module>
        <module>summer-web-http</module>
        <module>summer-web-netty</module>
        <module>summer-web-middleware</module>
        <module>summer-web-websocket</module>
        <module>summer-boot</module>
        <module>summer-aop</module>
        <module>summer-tx</module>
                <module>summer-runtime</module>
                <module>summer-runtime-web</module>
        <module>summer-engine</module>
        <module>summer-aot-engine</module>
        <module>summer-boot-starter</module>
        <module>summer-boot-starter-web</module>
        <module>summer-boot-starter-data-jdbc</module>
        <module>summer-boot-starter-data-redis</module>
        <module>summer-boot-starter-websocket</module>
        <module>summer-boot-starter-grpc</module>
        <module>summer-grpc</module>
        <module>summer-data-redis</module>
        <module>summer-data-jdbc</module>
        <module>summer-test</module>
        <module>summer-test-db</module>
        <module>summer-test-starter</module>
        <module>summer-tck</module>
        <module>summer-tck-fixtures</module>
        <module>summer-tck-invisible-fixtures</module>
        <module>summer-maven-plugin</module>
        <module>summer-archunit</module>
        <module>summer-coverage-report</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>io.github.dropguard</groupId>
                    <artifactId>summer-maven-plugin</artifactId>
                    <version>${project.version}</version>
                    <executions>
                        <execution>
                            <id>generate-aot</id>
                            <phase>process-classes</phase>
                            <goals>
                                <goal>generate-aot</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>clean-generated-sources</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/generated-sources/annotations</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>check</goal></goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        
            <!-- Auto-install Git hooks when developers build the project -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <inherited>false</inherited> <!-- Only run in root -->
                <executions>
                    <execution>
                        <id>install-git-hooks</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>git</executable>
                            <arguments>
                                <argument>config</argument>
                                <argument>core.hooksPath</argument>
                                <argument>.githooks</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
