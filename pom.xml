<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.dropguard</groupId>
        <artifactId>summer-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>summer-parent/pom.xml</relativePath>
    </parent>

    <artifactId>summer-framework</artifactId>
    <packaging>pom</packaging>

    <name>Summer Framework</name>
    <description>A minimal, chain-oriented micro framework for building CRUD APIs on modern JDK</description>
    <url>https://github.com/your-username/summer</url>

    <properties>
        <summer.framework.version>${project.version}</summer.framework.version>
        <jacoco.version>0.8.15</jacoco.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.github.dropguard</groupId>
                <artifactId>summer-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <!-- Parents as modules: the archetype IT's generated project resolves summer-build-parent
             from the local repository, so `mvn clean install` must install it (and its parent
             summer-parent, which nothing else installs). -->
        <module>summer-parent</module>
        <module>summer-build-parent</module>
        <module>summer-core</module>
        <module>summer-web</module>
        <module>summer-web-http</module>
        <module>summer-web-netty</module>
        <module>summer-web-middleware</module>
        <module>summer-web-websocket</module>
        <module>summer-boot</module>
        <module>summer-aop</module>
        <module>summer-tx</module>
                <module>summer-runtime</module>
                <module>summer-runtime-web</module>
        <module>summer-engine</module>
        <module>summer-dependencies</module>
        <module>summer-aot-engine</module>
        <module>summer-boot-starter</module>
        <module>summer-boot-starter-web</module>
        <module>summer-boot-starter-data-jdbc</module>
        <module>summer-boot-starter-data-redis</module>
        <module>summer-boot-starter-websocket</module>
        <module>summer-boot-starter-grpc</module>
        <module>summer-grpc</module>
        <module>summer-data-redis</module>
        <module>summer-data-jdbc</module>
        <module>summer-test</module>
        <module>summer-tck</module>
        <module>summer-tck-fixtures</module>
        <module>summer-tck-negative-fixtures</module>
        <module>summer-archetype</module>
        <module>summer-maven-plugin</module>
        <module>summer-archunit</module>
        <module>summer-coverage-report</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.github.dropguard</groupId>
                    <artifactId>summer-maven-plugin</artifactId>
                    <version>${project.version}</version>
                    <executions>
                        <execution>
                            <id>generate-aot</id>
                            <phase>process-classes</phase>
                            <goals>
                                <goal>generate-aot</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>clean-generated-sources</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/generated-sources/annotations</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>check</goal></goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <!-- GitHub Packages registry (maven.pkg.github.com keeps one repository for releases
             and snapshots alike). Deploy needs a GITHUB_TOKEN with packages:write on
             DropGuard/Summer, wired into settings.xml under the 'github' server id. Maven
             Central is intentionally deferred: the framework is not published there yet. -->
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/DropGuard/Summer</url>
        </repository>
    </distributionManagement>
</project>
