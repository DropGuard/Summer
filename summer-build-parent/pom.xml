<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      summer-build-parent — the parent POM for demos and external Summer projects.

      It inherits the build contract (compiler, jandex, surefire/failsafe versions
      and argLine) from summer-parent.

      It adds:
        - summer-dependencies BOM import (dependency version catalog)
        - summer-maven-plugin (AOT generation, mandatory for every project)

      summer.framework.version defaults to 0.1.0 here — demos always build against
      a published release. Within the reactor, summer-framework overrides it to
      ${project.version}.
    -->

    <parent>
        <groupId>io.github.dropguard</groupId>
        <artifactId>summer-parent</artifactId>
        <version>0.2.0</version>
        <!-- summer-parent is a reactor sibling (since 2026-08-08): resolve it by path, not from
             the repository, so the parent chain works in a fresh build before any install. -->
        <relativePath>../summer-parent/pom.xml</relativePath>
    </parent>

    <artifactId>summer-build-parent</artifactId>
    <version>0.2.0</version>
    <packaging>pom</packaging>

    <name>Summer Build Parent</name>
    <description>Parent POM for Summer applications — adds the dependency version catalog and AOT plugin</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.dropguard</groupId>
                <artifactId>summer-dependencies</artifactId>
                <version>${summer.framework.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The framework parent (summer-parent) declares logback-classic test-scoped so nothing
             leaks into the framework jars; apps inherit that declaration, and nearest-wins
             dependency mediation lets the explicit test scope shadow summer-boot's compile-scoped
             transitive logback down to nothing (the app boots with no logging backend and crashes
             in LoggingConfigurer). dependencyManagement scope cannot override an explicit scope on
             a direct dependency, so the app parent declares the backend compile-scoped directly —
             the same dependency, same version (BOM-managed), guaranteed on the app's runtime
             classpath. The boot layer still owns logging; the framework jars stay clean. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Bound, not pluginManagement: the Jandex index is a pure build prerequisite for
                 both engines (Runtime scans it at startup; the AOT plugin consumes it), so every
                 Summer app gets it with zero declaration. Version + execution come from
                 summer-parent's pluginManagement. -->
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
            <!-- Bound, not pluginManagement: AOT generation is mandatory for every Summer app
                 (a build-time context generator), so every app gets it with zero declaration —
                 the same reasoning as Jandex above. An app is a runnable artifact, so the AOT
                 plugin belongs on the app parent (build-parent), never on summer-parent (which
                 parents framework libraries that must not run code generation). The version and
                 execution are declared here directly — unlike Jandex, summer-parent's
                 pluginManagement does not own this plugin's version, so they cannot be inherited. -->
            <plugin>
                <groupId>io.github.dropguard</groupId>
                <artifactId>summer-maven-plugin</artifactId>
                <version>${summer.framework.version}</version>
                <executions>
                    <execution>
                        <id>generate-aot</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>generate-aot</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
