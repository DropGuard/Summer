<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>summer</groupId>
        <artifactId>summer-framework</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>summer-boot</artifactId>
    <name>Summer Boot</name>
    <description>Application bootstrap module for Summer framework</description>

    <dependencies>
        <!-- Summer Web (for ParameterResolver, annotations, web types) -->
        <dependency>
            <groupId>summer</groupId>
            <artifactId>summer-web</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Summer Web Netty (for NettyHttpServer) -->
        <dependency>
            <groupId>summer</groupId>
            <artifactId>summer-web-netty</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Summer Runtime (for RuntimeDiEngine) -->
        <dependency>
            <groupId>summer</groupId>
            <artifactId>summer-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Summer AOP (for ProxyFactory and MethodInterceptor) -->
        <dependency>
            <groupId>summer</groupId>
            <artifactId>summer-aop</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Jackson for JSON binding -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Netty -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
        </dependency>

        <!-- Jakarta Validation API -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>3.0.2</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
