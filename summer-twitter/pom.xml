<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      External demo project. Inherits summer-starter-parent (same convention as a
      Spring Boot app inheriting spring-boot-starter-parent): the parent supplies the
      AOT / Jandex / compiler build wiring so this pom stays thin, while the demo still
      builds independently and consumes Summer purely as published artifacts. The
      parent is NOT part of the framework reactor.
    -->
    <parent>
        <groupId>io.github.dropguard</groupId>
        <artifactId>summer-build-parent</artifactId>
        <version>0.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.github.dropguard.summer.twitter</groupId>
    <artifactId>summer-twitter</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>
    <name>Summer Twitter</name>
    <description>Summer Framework showcase application: A micro Twitter clone</description>

    <dependencies>
        <!-- Summer starters: core is pulled in transitively by each. -->
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-boot-starter-web</artifactId>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-boot-starter-data-jdbc</artifactId>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-boot-starter-data-redis</artifactId>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-boot-starter-websocket</artifactId>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-boot-starter-grpc</artifactId>
            <type>pom</type>
        </dependency>

        <!-- PostgreSQL Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
        </dependency>

        <!-- BCrypt -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The user-facing test entry: one dependency for the @SummerTest infrastructure, the
             database test resources, and the transitives (testcontainers for the demo's own
             containers). The demo consumes the framework the way a real user does. -->
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-test-starter</artifactId>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>summer-twitter</finalName>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.github.dropguard.summer.twitter.Application</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.github.dropguard.summer.twitter.Application</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!-- IT-bearing: zero executed tests fails the build (the silent-skip guard). -->
                    <failIfNoTests>true</failIfNoTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
