<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.dropguard</groupId>
        <artifactId>summer-framework</artifactId>
        <version>0.3.4-SNAPSHOT</version>
    </parent>

    <artifactId>summer-boot-starter</artifactId>
    <packaging>pom</packaging>
    <name>Summer Boot Starter (Core)</name>
    <description>
        Core starter for any Summer application: the DI container, AOP/transaction
        support, bootstrap, and the logging binding every app owns. Pull this in
        instead of listing the individual framework modules. Capability starters
        (web, data-*) depend on this one.
    </description>

    <dependencies>
        <!-- DI container + bootstrap (the foundation everything else builds on) -->
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-boot</artifactId>
        </dependency>

        <!-- Cross-cutting framework modules most apps need -->
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-tx</artifactId>
        </dependency>

        <!-- Logging: the starter ships logback-classic (the binding) and the boot applies the
             framework's programmatic defaults (LoggingConfigurer — the Spring Boot LoggingSystem
             model) when the app has no logback config: no-config apps get root INFO + the framework
             pattern instead of logback's DEBUG-level BasicConfigurator noise. Apps with their own
             logback.xml win (the standard auto-config), or replace the binding via Maven exclusion.
             The framework's main classpath carries no logback.xml, so it never races a consumer's
             logging config. The library modules stay SLF4J-only for starter-less embedded use. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
    </dependencies>
</project>
