<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.dropguard</groupId>
        <artifactId>summer-framework</artifactId>
        <version>0.3.1-SNAPSHOT</version>
    </parent>

    <artifactId>summer-web-netty</artifactId>
    <name>Summer Web Netty</name>
    <description>Netty HTTP server implementation for Summer framework</description>

    <dependencies>
        <!-- Summer Web (interfaces) -->
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-web</artifactId>
        </dependency>
        <!-- Summer Web HTTP (implementations) -->
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-web-http</artifactId>
        </dependency>

        <!-- Netty -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-test</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- AOT engine: @DualEngine WebSocket tests build the AOT leg's whole universe. -->
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-aot-engine</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Runtime web bridge: test apps rely on RuntimeWebConfiguration to register routes -->
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-runtime-web</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-web-websocket</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals><goal>jandex</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
