<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ===================================================================
         summer-parent — the mandatory build contract for EVERY Summer project.

         AOT requires specific plugin bindings that are correctness-critical
         (not convenience). Users must not hand-write <phase>/<goal> for the
         Jandex and AOT-generation plugins — getting them wrong produces
         silent runtime failures, not compile errors.

         This POM provides the single source of truth for the build pipeline:
           compile         → jandex:jandex          (indexes beans)
           process-classes → summer:generate-aot     (generates AOT context)
           test            → surefire:test           (with Unsafe access)
           verify          → failsafe:verify         (IT, opt-in per module)

         The framework reactor and every demo inherit from here.
         There are NO <modules> — this is pure build contract.
    =================================================================== -->

    <groupId>com.github.dropguard</groupId>
    <artifactId>summer-parent</artifactId>
    <version>999-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Summer Parent</name>
    <description>Mandatory build contract for Summer projects — AOT pipeline, Jandex indexing, compiler settings</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <argLine></argLine>

        <!--
          The published version of the Summer framework. Used to resolve the BOM and
          summer-maven-plugin at a version independent of the inheriting project's own
          <version>. Demo projects and the reactor both set this; when the reactor
          advances this property the demos follow without touching their own <version>.
        -->
        <summer.framework.version>999-SNAPSHOT</summer.framework.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <!-- ============================================================
                     Compiler: Java 25, full annotation processing (AOT needs it)
                     ============================================================ -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <parameters>true</parameters>
                        <proc>full</proc>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>io.avaje</groupId>
                                <artifactId>avaje-validator-generator</artifactId>
                                <version>2.17</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <!-- ============================================================
                     Jandex: MANDATORY. Binds to compile phase; the AOT generator
                     reads jandex.idx to discover beans.
                     ============================================================ -->
                <plugin>
                    <groupId>io.smallrye</groupId>
                    <artifactId>jandex-maven-plugin</artifactId>
                    <version>3.5.3</version>
                    <executions>
                        <execution>
                            <id>make-index</id>
                            <phase>compile</phase>
                            <goals>
                                <goal>jandex</goal>
                            </goals>
                            <configuration>
                                <classesDir>${project.build.outputDirectory}</classesDir>
                                <indexDir>${project.build.outputDirectory}/META-INF</indexDir>
                                <indexName>jandex.idx</indexName>
                                <processDefaultFileSet>true</processDefaultFileSet>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!-- ============================================================
                     Surefire: -Dsun-misc-unsafe-memory-access=allow is REQUIRED.
                     AOT-generated code uses Unsafe for field access; JDK 25
                     denies it by default.
                     ============================================================ -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>
                    <configuration>
                        <argLine>@{argLine} --sun-misc-unsafe-memory-access=allow</argLine>
                        <redirectTestOutputToFile>true</redirectTestOutputToFile>
                    </configuration>
                </plugin>

                <!-- ============================================================
                     Failsafe: opt-in per module (add plugin in plugins section).
                     Version and Unsafe argLine are inherited from here.
                     ============================================================ -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.5.5</version>
                    <configuration>
                        <argLine>@{argLine} --sun-misc-unsafe-memory-access=allow</argLine>
                    </configuration>
                </plugin>

                <!-- ============================================================
                     Release (Quarkus-style): the version is a constant SNAPSHOT
                     during development; `mvn release:prepare` automates the
                     milestone sweep (SNAPSHOT -> release, all submodules, tag
                     v<version>, bump to the next SNAPSHOT) and the tag push fires
                     the publish workflow. No manual version edits.
                     ============================================================ -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>3.1.1</version>
                    <configuration>
                        <tagNameFormat>v@{project.version}</tagNameFormat>
                        <autoVersionSubmodules>true</autoVersionSubmodules>
                    </configuration>
                </plugin>

                <!-- ============================================================
                     Spotless: format gate. Version + rules declared here so the
                     reactor can bind spotless:check at verify. Demos do NOT
                     auto-bind — they opt in by adding the plugin to their own
                     <plugins>.
                     ============================================================ -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>2.44.5</version>
                    <configuration>
                        <java>
                            <googleJavaFormat>
                                <version>1.35.0</version>
                                <style>AOSP</style>
                                <reflowLongStrings>true</reflowLongStrings>
                                <reorderImports>true</reorderImports>
                            </googleJavaFormat>
                            <removeUnusedImports />
                            <importOrder />
                        </java>
                    </configuration>
                </plugin>

                <!-- ============================================================
                     JaCoCo: opt-in per module. Version only — modules that want
                     coverage add <plugin> in their own <plugins>.
                     ============================================================ -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.15</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- ================================================================
             Active plugins: MANDATORY for every project.
             compiler + jandex + summer-maven-plugin run on every build.
             ================================================================ -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <!-- The *IT tests were silently skipped: the failsafe's goals are NOT part of the
                 default lifecycle bindings — a bare plugin declaration (no executions) never runs
                 them. Explicit bindings run the integration tests at verify (the CI's stale
                 "integration-tests profile" comment never existed). Modules without ITs pass via
                 failIfNoTests=false. -->
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <failIfNoTests>false</failIfNoTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <!-- Test logging backend for every module's tests. The framework's tests were running
             with SLF4J's NOP provider — all [Summer] diagnostics were silent in the reactor (only
             the demos, which ship their own logback, ever showed them). Test scope so nothing
             leaks into the framework jars. The logback.xml lives in summer-core's main resources
             and is on the test classpath via the main jar. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.18</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <distributionManagement>
        <!-- summer-parent is top-level (no parent of its own) and does not inherit the
             framework root's distributionManagement; without this its deploy fails. Same
             registry as the root. -->
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/DropGuard/Summer</url>
        </repository>
    </distributionManagement>
</project>