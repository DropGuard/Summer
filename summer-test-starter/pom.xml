            <groupId>com.github.dropguard</groupId>
            <artifactId>summer-test</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.dropguard</groupId>
            <artifactId>summer-test-db</artifactId>
        </dependency>
    </dependencies>
</project>
