<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>summer</groupId>
        <artifactId>summer-framework</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>summer-compiler</artifactId>
    <name>Summer Compiler (APT)</name>
    <description>Annotation processing tool for compile-time code generation in Summer framework</description>

    <dependencies>
        <!-- Summer Core (for annotations) -->
        <dependency>
            <groupId>summer</groupId>
            <artifactId>summer-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Summer AOP (for @Intercepts, MethodInterceptor, ProxyFactory references in generated code) -->
        <dependency>
            <groupId>summer</groupId>
            <artifactId>summer-aop</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Jandex for reading pre-built class indexes at compile time -->
        <dependency>
            <groupId>io.smallrye</groupId>
            <artifactId>jandex</artifactId>
        </dependency>

        <!-- JavaPoet for source code generation (Palantir fork - modern JDK support) -->
        <dependency>
            <groupId>com.palantir.javapoet</groupId>
            <artifactId>javapoet</artifactId>
        </dependency>

        <!-- AutoService for registering the processor -->
        <dependency>
            <groupId>com.google.auto.service</groupId>
            <artifactId>auto-service</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.google.testing.compile</groupId>
            <artifactId>compile-testing</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.google.truth</groupId>
            <artifactId>truth</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Summer framework modules — needed at compile time for Jandex-based bean discovery.
             Their jandex.idx files must be on the annotation processor classpath. -->
        <dependency>
            <groupId>summer</groupId>
            <artifactId>summer-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>summer</groupId>
            <artifactId>summer-tx</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>summer</groupId>
            <artifactId>summer-data-jdbc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>summer</groupId>
            <artifactId>summer-data-redis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>summer</groupId>
            <artifactId>summer-grpc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>summer</groupId>
            <artifactId>summer-validation-hv</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.auto.service</groupId>
                            <artifactId>auto-service</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
