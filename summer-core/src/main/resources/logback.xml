<configuration>
	<!-- Summer: INFO by default. Flip to DEBUG when troubleshooting DI/resolution -->
	<logger name="summer" level="INFO"/>

	<!-- Suppress noisy third-party DEBUG logs -->
	<logger name="com.zaxxer.hikari" level="WARN"/>
	<logger name="org.jboss.jandex" level="WARN"/>

	<root level="INFO">
		<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
			<encoder>
				<pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} -- %msg%n</pattern>
			</encoder>
		</appender>
	</root>
</configuration>
