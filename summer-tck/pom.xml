<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>summer-framework</artifactId>
        <groupId>com.github.dropguard</groupId>
        <version>999-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>summer-tck</artifactId>
    <name>Summer Test Compatibility Kit</name>
    <description>Unified test suite for Summer dual DI engines</description>

    <dependencies>
        <!-- All Summer deps are compile-scoped in this test-only module
             so the AOT plugin can discover beans via Jandex -->
        <dependency>
            <groupId>com.github.dropguard</groupId>
            <artifactId>summer-tck-fixtures</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.dropguard</groupId>
            <artifactId>summer-tck-negative-fixtures</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency><groupId>com.github.dropguard</groupId><artifactId>summer-test</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.github.dropguard</groupId><artifactId>summer-core</artifactId></dependency>
        <dependency><groupId>com.github.dropguard</groupId><artifactId>summer-runtime</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.github.dropguard</groupId><artifactId>summer-engine</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.github.dropguard</groupId><artifactId>summer-aop</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.github.dropguard</groupId><artifactId>summer-web</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.github.dropguard</groupId><artifactId>summer-runtime-web</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.github.dropguard</groupId><artifactId>summer-web-http</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.github.dropguard</groupId><artifactId>summer-web-websocket</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.github.dropguard</groupId><artifactId>summer-boot</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.github.dropguard</groupId><artifactId>summer-tx</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.github.dropguard</groupId><artifactId>summer-grpc</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.github.dropguard</groupId><artifactId>summer-data-jdbc</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.github.dropguard</groupId><artifactId>summer-data-redis</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.github.dropguard</groupId><artifactId>summer-web-netty</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.github.dropguard</groupId><artifactId>summer-aot-engine</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId></dependency>
        <dependency><groupId>com.zaxxer</groupId><artifactId>HikariCP</artifactId></dependency>
        <dependency><groupId>io.grpc</groupId><artifactId>grpc-stub</artifactId></dependency>
        <dependency><groupId>com.google.protobuf</groupId><artifactId>protobuf-java</artifactId><version>3.25.5</version></dependency>
        <!-- JUnit and Mockito are supplied transitively by summer-test. -->
    </dependencies>

    <build>
        <plugins>
            <!--
              JaCoCo: instruments the TCK test JVM so coverage from the AOT engine
              (exercised by @DualEngine methods) is actually collected. The
              prepare-agent execution is inherited from pluginManagement; surefire
              already consumes @{argLine}, so the empty <argLine> property in the
              root pom is filled in here with no conflict.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
                    <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>