<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>summer-framework</artifactId>
        <groupId>summer</groupId>
        <version>0.1.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>summer-tck</artifactId>
    <name>Summer Test Compatibility Kit</name>
    <description>Unified test suite for Summer dual DI engines</description>

    <dependencies>
        <!-- All Summer deps are compile-scoped in this test-only module
             so the AOT plugin can discover beans via Jandex -->
        <dependency>
            <groupId>summer</groupId>
            <artifactId>summer-tck-fixtures</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency><groupId>summer</groupId><artifactId>summer-test</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>summer</groupId><artifactId>summer-core</artifactId></dependency>
        <dependency><groupId>summer</groupId><artifactId>summer-runtime</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>summer</groupId><artifactId>summer-aop</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>summer</groupId><artifactId>summer-web</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>summer</groupId><artifactId>summer-web-http</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>summer</groupId><artifactId>summer-web-websocket</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>summer</groupId><artifactId>summer-boot</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>summer</groupId><artifactId>summer-tx</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>summer</groupId><artifactId>summer-grpc</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>summer</groupId><artifactId>summer-data-jdbc</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>summer</groupId><artifactId>summer-aot-engine</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId></dependency>
        <dependency><groupId>com.zaxxer</groupId><artifactId>HikariCP</artifactId></dependency>
        <dependency><groupId>io.grpc</groupId><artifactId>grpc-stub</artifactId></dependency>
        <dependency><groupId>com.google.protobuf</groupId><artifactId>protobuf-java</artifactId><version>3.25.5</version></dependency>
        <!-- Test-only deps remain test scoped -->
        <dependency><groupId>org.mockito</groupId><artifactId>mockito-junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-test-index</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                        <configuration>
                            <processDefaultFileSet>false</processDefaultFileSet>
                            <indexName>jandex-test.idx</indexName>
                            <indexDir>${project.build.testOutputDirectory}/META-INF</indexDir>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.testOutputDirectory}</directory>
                                    <!--
                                      Sad-path fixtures (fixtures/di/errors) are deliberately-broken
                                      beans used ONLY by narrow @SummerTest(classes=...) tests. They
                                      must NOT enter the shared jandex-test.idx: doing so poisons every
                                      whole-universe @SummerTest container (it tries to wire a bean whose
                                      dependency is unregistered). This mirrors Quarkus, where negative
                                      test fixtures live only in the ArcTestContainer's own Indexer-built
                                      index and never in the shared application index. Narrow tests reach
                                      these fixtures via NarrowIndexBuilder, which indexes the seed .class
                                      bytes directly from the classpath and does not read jandex-test.idx
                                      at all — so excluding them here has zero effect on the owning tests.
                                      The fixtures/ tree contains ONLY sad-path fixtures, so this single
                                      exclusion is a clean archive-boundary, not a fragile name glob.
                                    -->
                                    <excludes>
                                        <exclude>**/fixtures/di/errors/**</exclude>
                                    </excludes>
                                </fileSet>
                            </fileSets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>summer</groupId>
                <artifactId>summer-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <id>generate-aot-test</id>
                        <phase>process-test-classes</phase>
                        <configuration><testPhase>true</testPhase></configuration>
                        <goals><goal>generate-aot</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              JaCoCo: instruments the TCK test JVM so coverage from the AOT engine
              (exercised by @DualEngine methods) is actually collected. The
              prepare-agent execution is inherited from pluginManagement; surefire
              already consumes @{argLine}, so the empty <argLine> property in the
              root pom is filled in here with no conflict.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>