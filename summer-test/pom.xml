<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.dropguard</groupId>
        <artifactId>summer-framework</artifactId>
        <version>999-SNAPSHOT</version>
    </parent>

    <artifactId>summer-test</artifactId>
    <name>Summer Test</name>
    <description>Test infrastructure for Summer framework</description>

    <dependencies>
        <dependency>
            <groupId>com.github.dropguard</groupId>
            <artifactId>summer-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.dropguard</groupId>
            <artifactId>summer-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.dropguard</groupId>
            <artifactId>summer-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Full JUnit + Mockito runtime, compile-scoped so consumers of summer-test (test
             scope) transparently get a runnable test runtime without declaring JUnit/Mockito.
             junit-jupiter-api is part of the aggregate and is what summer-test's public API
             (@SummerTest, @DualEngine) references on the main classpath. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- Mockito JUnit integration: brings @Mock / MockitoExtension and transitively
             mockito-core, so consumers need not declare any Mockito artifact directly. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- Shared external-resource test support: Testcontainers + the PostgresTestResource.
             The resource lives WITH its SPI (the TestResource javadoc uses it as the example), so
             the tck's dual-engine real-DB tests and the data-jdbc module's ITs share one copy
             without a dependency cycle (summer-test is below the runtime/fixtures layer). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <!-- Override the BOM's test scope: the resource ships in summer-test's MAIN. -->
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>compile</scope>
        </dependency>
    </dependencies>
        <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
