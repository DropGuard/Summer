<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.dropguard</groupId>
        <artifactId>summer-framework</artifactId>
        <version>0.3.0</version>
    </parent>

    <artifactId>summer-test</artifactId>
    <name>Summer Test</name>
    <description>Test infrastructure for Summer framework</description>

    <dependencies>
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.dropguard</groupId>
            <artifactId>summer-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Full JUnit + Mockito runtime, compile-scoped so consumers of summer-test (test
             scope) transparently get a runnable test runtime without declaring JUnit/Mockito.
             junit-jupiter-api is part of the aggregate and is what summer-test's public API
             (@SummerTest, @DualEngine) references on the main classpath. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- The launcher API: SummerTestLifecycle is a ServiceLoader-registered
             TestExecutionListener, so it can log the universe-cache telemetry at the suite end
             (while logback is alive) instead of in the JVM shutdown hook. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- Mockito JUnit integration: brings @Mock / MockitoExtension and transitively
             mockito-core, so consumers need not declare any Mockito artifact directly. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- No testcontainers here: the PostgresTestResource moved to summer-test-db so the core
             test infrastructure never forces testcontainers on consumers that do not use a DB
             resource. summer-test's own tests use fake resources only. -->
    </dependencies>
        <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
