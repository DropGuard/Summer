<configuration>
	<!-- NOTE: logback consults logback-test.xml BEFORE logback.xml. This file ships in
	     summer-test's main (a test-scoped dependency), so it overrides an application's own
	     logback.xml during tests — the framework's INFO default applies unless the consumer
	     provides its own logback-test.xml (which wins on the classpath). This mirrors Spring
	     Boot's starter-test intentionally NOT shipping a logback-test.xml, minus the surprise:
	     documented here rather than silent.
	     Summer: INFO by default. Flip to DEBUG when troubleshooting DI/resolution -->
	<logger name="summer" level="INFO"/>

	<!-- Suppress noisy third-party DEBUG logs -->
	<logger name="com.zaxxer.hikari" level="WARN"/>
	<logger name="org.jboss.jandex" level="WARN"/>

	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} -- %msg%n</pattern>
		</encoder>
	</appender>

	<root level="INFO">
		<appender-ref ref="STDOUT"/>
	</root>
</configuration>
